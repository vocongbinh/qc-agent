#!/usr/bin/env bash
# Pika CLI — Autonomous QC, Debug & Coding Agent
# Usage:
#   pika              -> Opens interactive TUI Dashboard
#   pika run "..."    -> Runs headless test
#   pika status       -> Checks active LLM provider & models
#   pika login        -> Authenticates Google Antigravity / Gemini

# Resolve physical directory through symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Resolve Python interpreter (prefer project .venv)
if [ -x "$REPO_DIR/.venv/bin/python" ]; then
    PYTHON_BIN="$REPO_DIR/.venv/bin/python"
elif [ -n "$VIRTUAL_ENV" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
    PYTHON_BIN="$VIRTUAL_ENV/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
else
    echo "Error: Python 3 not found." >&2
    exit 1
fi

export PYTHONPATH="$REPO_DIR:$PYTHONPATH"

# If no arguments provided, launch TUI dashboard directly
if [ $# -eq 0 ]; then
    exec "$PYTHON_BIN" "$REPO_DIR/main.py" repl
else
    exec "$PYTHON_BIN" "$REPO_DIR/main.py" "$@"
fi
